{
  "info": {
    "_postman_id": "a7b9c2d4-3e61-4a8b-9d10-202611250008",
    "name": "ПланГрафик — ЛР8 REST API",
    "description": "Проверка создания, чтения, назначения ответственного и смены статуса заявок на планирование отпусков. Данные хранятся в памяти backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "requestId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01. Создать заявку — 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/vacation-requests",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Планирование отпусков участка связи\",\n  \"siteId\": 2,\n  \"description\": \"Подготовить проект графика отпусков работников участка связи.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.expect(data).to.have.property('id');",
              "pm.expect(data.number).to.match(/^VR-\\d{5}$/);",
              "pm.expect(data.status).to.eql('New');",
              "pm.expect(data.assigneeUserId).to.eql(null);",
              "pm.collectionVariables.set('requestId', data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Создать заявку с коротким title — 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/vacation-requests",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"abc\",\n  \"siteId\": 2,\n  \"description\": \"Описание тестовой заявки для проверки.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
